# Keep source files consistent across Windows and hosted previews.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Preserve the original bytes of media and submission documents.
*.webp binary
*.jpg binary
*.png binary
*.pdf binary
